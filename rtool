local function addToWhitelist(userId)
    if not isWhitelister(LocalPlayerUserId) then
        warn("❌ Only whitelister or owner can add users")
        return false
    end
    Whitelist[userId] = true
    print("✅ Added UserID " .. userId .. " to whitelist")
    return true
end

local function removeFromWhitelist(userId)
    if not isWhitelister(LocalPlayerUserId) then
        warn("❌ Only whitelister or owner can remove users")
        return false
    end
    if userId == OWNER_USERID then
        warn("❌ Cannot remove owner from whitelist")
        return false
    end
    Whitelist[userId] = nil
    print("❌ Removed UserID " .. userId .. " from whitelist")
    return true
end

