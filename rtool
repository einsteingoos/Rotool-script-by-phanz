--===============================================
-- FIRE FUNCTIONS
--===============================================
local function firev(name, args, m)
    local char = Character
    local tool = Backpack:FindFirstChild(name) or char:FindFirstChild(name)
    if not tool then 
        warn("❌ Tool not found: " .. name)
        return false
    end
    tool.Parent = char
    local event = tool
    for _, v in ipairs(m) do
        event = event:FindFirstChild(v)
        if not event then 
            warn("❌ Event not found: " .. v)
            return false
        end
    end
    event:FireServer(table.unpack(args))
    return true
end

local function fireDaggerAbility()
    local dagger = Backpack:FindFirstChild("DaggerOfShatteredDimensions") or Character:FindFirstChild("DaggerOfShatteredDimensions")
    if not dagger then
        warn("⚠️ Dagger not found!")
        return false
    end
    dagger.Parent = Character
    task.wait(0.3)
    local remote = dagger:FindFirstChild("Remote")
    if remote then
        remote:FireServer(Enum.KeyCode.Q)
        print("✅ Dagger ability fired!")
    end
    return true
end

--===============================================
-- ROTATE TOOL LOGIC
--===============================================
local function createRotateTool()
    local rotateTool = Instance.new("Tool")
    rotateTool.Name = "Rotation Tool"
    rotateTool.RequiresHandle = false

    local snapAngle = 15
    local selectedPart = nil
    local ghostPart = nil
    local handlePart = nil
    local dragStartCFrame = nil

    local arcHandles = Instance.new("ArcHandles")
    arcHandles.Parent = CoreGui

    local selectionBox = Instance.new("SelectionBox")
    selectionBox.LineThickness = 0.05
    selectionBox.SurfaceTransparency = 1
    selectionBox.Color3 = Color3.fromRGB(79, 158, 255)
    selectionBox.Parent = CoreGui

    GUI.AngleTextBox:GetPropertyChangedSignal("Text"):Connect(function()
        local text = GUI.AngleTextBox.Text
        local num = tonumber(text)
        if text == "" then
            snapAngle = 15
            GUI.AngleLabel.Text = "Rotation Angle: 15"
        elseif num then
            snapAngle = num
            GUI.AngleLabel.Text = "Rotation Angle: " .. tostring(num)
        end
    end)

    local function clearSelection()
        if ghostPart then ghostPart:Destroy() end
        if handlePart then handlePart:Destroy() end
        ghostPart = nil
        handlePart = nil
        selectionBox.Adornee = nil
        arcHandles.Adornee = nil
        selectedPart = nil
        SELECTED_BRICK = nil
        GUI.StatusLabel.Text = "No brick selected"
        GUI.StatusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    end

    rotateTool.Equipped:Connect(function()
        GUI.ScreenGui.Enabled = true
    end)

    rotateTool.Unequipped:Connect(function()
        GUI.ScreenGui.Enabled = false
        clearSelection()
        dragStartCFrame = nil
    end)

    -- Whitelister add/remove buttons
    if isWhitelister(LocalPlayerUserId) then
        GUI.AddUserIdBox.FocusLost:Connect(function(enterPressed)
            if enterPressed then
                local userId = tonumber(GUI.AddUserIdBox.Text)
                if userId then
                    addToWhitelist(userId)
                    GUI.AddUserIdBox.Text = ""
                end
            end
        end)
        GUI.RemoveUserIdBox.FocusLost:Connect(function(enterPressed)
            if enterPressed then
                local userId = tonumber(GUI.RemoveUserIdBox.Text)
                if userId then
                    removeFromWhitelist(userId)
                    GUI.RemoveUserIdBox.Text = ""
                end
            end
        end)
    end

    playerMouse.Button1Down:Connect(function()
        if not GUI.ScreenGui.Enabled then return end
        local hitPart = playerMouse.Target
        
        if hitPart and hitPart:IsDescendantOf(brickFolder) and selectedPart ~= hitPart then
            clearSelection()
            selectedPart = hitPart
            SELECTED_BRICK = hitPart
            targetPos = selectedPart.Position

            GUI.StatusLabel.Text = "Selected: " .. selectedPart.Name
            GUI.StatusLabel.TextColor3 = Color3.fromRGB(60, 220, 100)

            ghostPart = selectedPart:Clone()
            ghostPart.Size = ghostPart.Size + Vector3.new(0.01, 0.01, 0.01)
            ghostPart.Transparency = 0.5
            ghostPart.Anchored = true
            ghostPart.CanCollide = false
            ghostPart.Parent = Workspace

            handlePart = selectedPart:Clone()
            handlePart.Size = selectedPart.Size + Vector3.new(0.01, 0.01, 0.01)
            handlePart.Transparency = 1
            handlePart.Anchored = true
            handlePart.CanCollide = false
            handlePart.Parent = Workspace

            selectionBox.Adornee = ghostPart
            arcHandles.Adornee = handlePart
        end
    end)

    arcHandles.MouseButton1Down:Connect(function(axis)
        if not selectedPart or not handlePart then return end
        dragStartCFrame = handlePart.CFrame
        arcHandles.Axes = Axes.new(axis)
    end)

    arcHandles.MouseDrag:Connect(function(axis, relativeAngle)
        if not ghostPart or not dragStartCFrame then return end
        local snapped = math.rad(math.round(math.deg(relativeAngle) / snapAngle) * snapAngle)
        local rx, ry, rz = 0, 0, 0
        if axis == Enum.Axis.X then rx = snapped
        elseif axis == Enum.Axis.Y then ry = snapped
        elseif axis == Enum.Axis.Z then rz = snapped end

        local newCFrame = dragStartCFrame * CFrame.Angles(rx, ry, rz)
        ghostPart.CFrame = newCFrame
        handlePart.CFrame = newCFrame
    end)

    arcHandles.MouseButton1Up:Connect(function()
        arcHandles.Axes = Axes.new(Enum.Axis.X, Enum.Axis.Y, Enum.Axis.Z)
    end)

    local function executeAction()
        if not ghostPart or not selectedPart then return end
        local targetCFrame = ghostPart.CFrame
        local partToRotate = selectedPart

        clearSelection()
        
        partToRotate.CFrame = targetCFrame
        GUI.StatusLabel.Text = "✅ Rotation Applied!"
        task.delay(2, function()
            if GUI.ScreenGui.Enabled then
                GUI.StatusLabel.Text = "No brick selected"
                GUI.StatusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
            end
        end)
    end

    -- SEQUENCE FUNCTION
    local function runSequence()
        if not SELECTED_BRICK then
            GUI.StatusLabel.Text = "⚠️ Select a brick first!"
            GUI.StatusLabel.TextColor3 = Color3.fromRGB(255, 180, 60)
            task.delay(2, function()
                GUI.StatusLabel.Text = "No brick selected"
                GUI.StatusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
            end)
            return
        end

        local brick = Workspace.Bricks[localPlayer.Name]:FindFirstChild("Brick")
        if not brick then
            GUI.StatusLabel.Text = "❌ Brick not found!"
            GUI.StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            return
        end

        local finalCFrame
        if ghostPart then
            finalCFrame = ghostPart.CFrame
        else
            finalCFrame = SELECTED_BRICK.CFrame
        end

        GUI.StatusLabel.Text = "⏳ 1/4 — Dagger..."
        GUI.StatusLabel.TextColor3 = Color3.fromRGB(79, 158, 255)
        fireDaggerAbility()
        task.wait(2.5)

        GUI.StatusLabel.Text = "⏳ 2/4 — Firing Collide × 2..."
        firev("Paint", {SELECTED_BRICK, nil, RootPart.Position, "both 🤝", Color3.fromRGB(-255, -255, -255), "collide", ""}, {"Script", "Event"})
        task.wait(1.5)
        firev("Paint", {SELECTED_BRICK, nil, RootPart.Position, "both 🤝", Color3.fromRGB(-255, -255, -255), "collide", ""}, {"Script", "Event"})

        GUI.StatusLabel.Text = "⏳ Waiting 7s..."
        task.wait(7)

        GUI.StatusLabel.Text = "⏳ 3/4 — Moving brick..."
        SELECTED_BRICK.Anchored = false
        local tween = TweenService:Create(SELECTED_BRICK, TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = finalCFrame})
        tween:Play()
        tween.Completed:Wait()
        SELECTED_BRICK.Anchored = true
        task.wait(0.5)

        GUI.StatusLabel.Text = "⏳ 4/4 — Firing Anchor..."
        firev("Paint", {SELECTED_BRICK, nil, RootPart.Position, "both 🤝", Color3.fromRGB(-255, -255, -255), "anchor", ""}, {"Script", "Event"})
        task.wait(0.5)

        GUI.StatusLabel.Text = "✅ DONE!"
        GUI.StatusLabel.TextColor3 = Color3.fromRGB(60, 220, 100)
        clearSelection()
        task.delay(3, function()
            if GUI.ScreenGui.Enabled then
                GUI.StatusLabel.Text = "No brick selected"
                GUI.StatusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
            end
        end)
    end

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.Q and GUI.ScreenGui.Enabled then
            executeAction()
        end
    end)

    GUI.ConfirmButton.MouseButton1Click:Connect(function()
        executeAction()
    end)

    GUI.SequenceButton.MouseButton1Click:Connect(function()
        runSequence()
    end)

    rotateTool.Parent = localPlayer.Backpack
end

